{
  "name": "agent_domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/common/index.js",
  "module": "./dist/common/index.js",
  "types": "./dist/common/index.d.ts",
  "exports": {
    ".": { "types": "./dist/common/index.d.ts", "import": "./dist/common/index.js" },
    "./common": { "types": "./dist/common/index.d.ts", "import": "./dist/common/index.js" },
    "./server": { "types": "./dist/server/index.d.ts", "import": "./dist/server/index.js" },
    "./front": { "types": "./dist/front/index.d.ts", "import": "./dist/front/index.js" },
    "./broker": { "types": "./dist/broker/index.d.ts", "import": "./dist/broker/index.js" },
    "./broker/worker": { "types": "./dist/broker/worker/index.d.ts", "import": "./dist/broker/worker/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node ../../scripts/run-tests.mjs src",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "pg": "8.23.0",
    "ws": "8.18.3"
  },
  "peerDependencies": {
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/pg": "8.21.0",
    "@types/ws": "8.18.1",
    "express": "5.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
