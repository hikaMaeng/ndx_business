PORT=18081
AGENT_HOST_PORT=18081
AGENT_ROLE=gateway
DATABASE_URL=postgres://postgres:postgres@admin:5432/ndx_business
AGENT_QUEUE=agent_requests
AGENT_RESULT_QUEUE=agent_results
AGENT_GATEWAY_QUEUE_PREFIX=agent_gateway_
AGENT_SUBSCRIPTION_LEASE_SECONDS=30
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
AGENT_EXECUTION_LEASE_SECONDS=120
AGENT_MAX_DELIVERY_READS=5
AGENT_MAX_EXECUTION_ATTEMPTS=5
AGENT_MAX_OUTBOX_ATTEMPTS=10
AGENT_MAX_GATEWAY_DELIVERY_ATTEMPTS=10
AGENT_TERMINAL_PERSISTENCE_ALERT_ATTEMPTS=10
AGENT_TERMINAL_PERSISTENCE_BACKOFF_MAX_SECONDS=300
AGENT_RETENTION_DAYS=30
QUEUE_POLL_SECONDS=5
QUEUE_POLL_BATCH_SIZE=8
AGENT_WEBSOCKET_MAILBOX_MAX=256
AGENT_WEBSOCKET_REPLAY_MAX=256
AGENT_WEBSOCKET_BUFFERED_BYTES=1048576
AGENT_MAX_QUEUE=64
AGENT_ROUTER_CONCURRENCY=12
AGENT_METRICS_TOKEN=local-agent-metrics

# --- vibe coding agent ---
# Inference target. host.docker.internal reaches the LM Studio server running
# on the host from inside the compose network.
VIBE_INFERENCE_BASE_URL=http://host.docker.internal:12345/v1
VIBE_INFERENCE_MODEL=nvidia-nemotron-3.5-lightning-30b-a3b
# Coding, not chat: low temperature because a stray token inside a heredoc
# silently corrupts the file being written.
VIBE_INFERENCE_TEMPERATURE=0.15
VIBE_INFERENCE_TOP_P=0.9
# This is a reasoning model; it spends tokens on reasoning_content before the
# tool call, so a small budget truncates mid-thought.
VIBE_INFERENCE_MAX_TOKENS=8192
VIBE_INFERENCE_TIMEOUT_MS=300000
VIBE_MAX_ITERATIONS=24
VIBE_TOOL_TIMEOUT_MS=120000
VIBE_TOOL_MAX_OUTPUT_BYTES=200000
VIBE_WORKSPACE_ROOT=/workspace
VIBE_ACCOUNT_BASE_URL=http://admin:18080
VIBE_SESSION_CACHE_MS=5000
# The client bundle this image carries. The broker serves it; it never builds it.
VIBE_CLIENT_DIR=/app/dist/front
