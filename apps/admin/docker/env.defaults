PORT=18080
ADMIN_PORT=18080
ADMIN_HOST_PORT=18080
# The admin image runs its own PostgreSQL, so admin reaches it over loopback
# inside its own container. Other services reach it as the host `admin`.
# The separate `postgres` service belongs to the `agent` app, which keeps its
# own database; do not point admin at it.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ndx_business
POSTGRES_DB=ndx_business
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PGDATA=/var/lib/postgresql/data
MASTER_ADMIN_EMAILS=hika00@gmail.com
