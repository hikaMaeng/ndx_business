# Compose host-port overrides. Copy this file to the ignored root .env, then
# change a value only when the default host port is already occupied.
#
# Two apps live here and both serve on container port 18081, so each needs its
# own host-port variable. They shared one until the agent app was merged, which
# meant neither could be moved without the other and the stack could not start.
ADMIN_HOST_PORT=18080
VIBEAGENT_HOST_PORT=18081
AGENT_GATEWAY_B_HOST_PORT=18082
AGENT_HOST_PORT=18083
