{
  "name": "ndx-business",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0 <24.15.0 || >=25.0.0 <25.7.0 || >=26.0.0 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "deploy": "bash scripts/deploy.sh",
    "deploy:all": "bash scripts/deploy.sh --all"
  },
  "devDependencies": {
    "turbo": "2.9.12",
    "typescript": "5.9.3"
  }
}
